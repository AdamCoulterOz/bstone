<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud Key-Value Storage: durable saved games / config / high scores. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>

	<!-- Per-Apple-TV-profile separation: run as the selected user so the app's
	     sandbox container AND its iCloud KVS are scoped to that profile, not the
	     device's primary iCloud account. REQUIRES the "User Management" capability
	     enabled on the au.adamcoulter.bstone App ID in the Apple Developer portal —
	     Xcode automatic signing cannot turn it on by itself, so a build will fail to
	     provision until the capability exists on the App ID. -->
	<key>com.apple.developer.user-management</key>
	<array>
		<string>runs-as-current-user</string>
	</array>
</dict>
</plist>
